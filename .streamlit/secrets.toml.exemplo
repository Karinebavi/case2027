# COMO USAR:
# 1) Renomeie este arquivo para  secrets.toml  (sem o .exemplo)
# 2) Coloque a senha real no lugar do TROCAR
# 3) No Streamlit Community Cloud, isso vai em: Settings > Secrets
#
# O arquivo secrets.toml NUNCA vai pro GitHub (está protegido no .gitignore).

senha_app = "TROCAR-pela-senha-real"

# Banco na nuvem (Supabase) — memória permanente + histórico de quem fez o quê.
# Supabase > Project Settings > API Keys. Use a chave SECRETA (sb_secret_...
# ou a antiga "service_role"). NUNCA a coloque no código nem mande por chat.
# Sem estas duas linhas, o sistema salva só neste computador (dados_base/).
supabase_url = "https://TROCAR.supabase.co"
supabase_key = "TROCAR-pela-chave-secreta"
